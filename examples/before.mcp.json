{
  "tools": [
    {
      "name": "search_docs",
      "description": "Search public documentation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "mode": {"enum": ["fast", "complete"]}
        },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  ]
}
